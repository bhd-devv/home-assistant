# Required: Ubuntu's actual Ethernet/LAN interface, from `ip -br addr`.
# This example is not automatically used by Compose. Copy to .env for CLI use,
# or set LAN_INTERFACE in the Coolify application's Environment Variables.
LAN_INTERFACE=enp3s0

# Optional image tags. Pin release versions after validating the first deployment.
HA_VERSION=stable
MATTER_VERSION=stable

# Persistent volumes: homeassistant_config and homeassistant_matter.
STACK_ID=homeassistant
